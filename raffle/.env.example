# Copy to .env and fill in. Never commit .env.

# Public URL of this app (no trailing slash). Must match the Discord redirect URL.
BASE_URL=http://localhost:8787
PORT=8787
NODE_ENV=production

# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Site name: shown in the header and in the X verification post.
SITE_NAME=Raffix

# Optional: pre-filled on every new raffle (admins can change per raffle).
DEFAULT_COLLECTION=
DEFAULT_X_FOLLOW=

# Discord app (https://discord.com/developers/applications → OAuth2)
# Redirect URL to add there: ${BASE_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Default server gate pre-filled on new raffles (right-click server → Copy Server ID).
DISCORD_GUILD_ID=
DISCORD_GUILD_NAME=
DISCORD_GUILD_INVITE=https://discord.gg/yourinvite

# Comma-separated Discord user IDs who can create/draw raffles.
ADMIN_DISCORD_IDS=

# Optional: channel webhook to post winners (Channel settings → Integrations → Webhooks).
DISCORD_WEBHOOK_URL=

# tweet  = users prove they own the X handle by posting a code (default, no X API)
# handle = users just type their handle (unverified, lowest friction)
X_VERIFY_MODE=tweet

# Where entries are stored. Put it on a persistent volume when deploying.
DATA_FILE=./data/raffle.json

# Set to 1 behind a reverse proxy (Railway, Render, Fly, nginx) so rate limits see real IPs.
TRUST_PROXY=1
